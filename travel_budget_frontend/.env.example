# Environment variables for Travel Budget Frontend
# IMPORTANT: Do not commit a real .env. Copy this file to .env and fill values.

# Base URL of backend API (e.g., https://api.yourdomain.com or http://localhost:8000)
REACT_APP_API_BASE_URL=https://backend.example.com

# Public site URL used for email redirects (if needed by backend flows)
REACT_APP_SITE_URL=http://localhost:3000

# Default currency code for UI
REACT_APP_DEFAULT_CURRENCY=USD
